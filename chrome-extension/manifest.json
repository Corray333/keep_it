{
  "manifest_version": 3,
  "name": "Keep it Extension",
  "version": "1.0",
  "description": "Keep it extension",
  "permissions": [
    "storage",
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "https://keep-it.xyz/*",
    "http://localhost*"
  ],
  "action": {
    "default_popup": "index.html"
  }
}